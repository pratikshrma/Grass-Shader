import { useEffect, useMemo, useRef,useState } from "react";
import * as THREE from "three";
import vertexShader from "../shaders/grass/vert.glsl?raw";
import fragmentShader from "../shaders/grass/frag.glsl?raw";
import vertexShaderCSM from "../shaders/grass/vert-csm.glsl?raw";
import fragmentShaderCSM from "../shaders/grass/frag-csm.glsl?raw";
import { useFrame, useThree } from "@react-three/fiber";
import { folder, useControls } from "leva";
import CustomShaderMaterial from "three-custom-shader-material/vanilla";

interface props {
  platform_width: number;
  platform_depth: number;
}

const Grass: React.FC<props> = ({ platform_depth, platform_width }) => {
  const { camera } = useThree();
  const { BLADE_COUNT, bladeBaseColor, bladeTipColor, bladeMaterial } =
    useControls({
      BladeSetting: folder({
        bladeMaterial: {
          value: "grassMaterialNonCSM",
          options: {
            "Physical Matrial Extenstion": "grassMaterialCSM",
            "Custom Material": "grassMaterialNonCSM",
          },
        },
        BLADE_COUNT: {
          value: 100000,
          min: 10000,
          max: 10000000,
          step: 100,
          label: "bladeCount",
        },
        bladeBaseColor: {
          value: "#096c13",
        },
        bladeTipColor: {
          value: "#96961e",
        },
      }),
    });

  const [highResBladeCount,setHighResBladeCount]= useState(0);
  const [lowResBladeCount,setLowResBladeCount]= useState(0);
  
  const [
    grassGeometryHigh,
    grassGeometryLow,
    grassMaterialNonCSM,
    grassMaterialCSM,
  ] = useMemo(() => {
    const mat1: THREE.ShaderMaterial = new THREE.ShaderMaterial({
      fragmentShader: fragmentShader,
      vertexShader: vertexShader,
      side: THREE.DoubleSide,
      uniforms: {
        uTime: { value: 0.0 },
        uBladeTipColor: { value: new THREE.Color("#096c13") },
        uBladeBaseColor: { value: new THREE.Color("#baba28") },
      },
      shadowSide: THREE.FrontSide,
    });

    const mat2: CustomShaderMaterial = new CustomShaderMaterial({
      baseMaterial: THREE.MeshPhysicalMaterial,
      fragmentShader: fragmentShaderCSM,
      vertexShader: vertexShaderCSM,
      side: THREE.DoubleSide,
      uniforms: {
        uTime: { value: 0.0 },
        uBladeTipColor: { value: new THREE.Color("#096c13") },
        uBladeBaseColor: { value: new THREE.Color("#baba28") },
      },
      shadowSide: THREE.FrontSide,
      transmission: 0.3,
      roughness: 0.7,
      metalness: 0.1,
    });

    const geoHigh: THREE.PlaneGeometry = new THREE.PlaneGeometry(0.2, 3, 4, 8);
    const geoLow: THREE.PlaneGeometry = new THREE.PlaneGeometry(0.2, 3, 4, 2);
    return [geoHigh, geoLow, mat1, mat2];
  }, []);

  const activeMaterial = useMemo(() => {
    if (bladeMaterial == "grassMaterialCSM") {
      return grassMaterialCSM;
    } else {
      return grassMaterialNonCSM;
    }
  }, [grassMaterialCSM, grassMaterialNonCSM, bladeMaterial]);

  useEffect(() => {
    activeMaterial.uniforms.uBladeTipColor.value = new THREE.Color(
      bladeTipColor,
    );
    activeMaterial.uniforms.uBladeBaseColor.value = new THREE.Color(
      bladeBaseColor,
    );
  }, [bladeBaseColor, bladeTipColor, activeMaterial]);

  const meshRefLow = useRef<THREE.InstancedMesh | null>(null);
  const meshRefHigh = useRef<THREE.InstancedMesh | null>(null);

  const masterGrassMatrix = useMemo(() => {
  const dummy =  new THREE.Object3D()
    const matrices = [];
    for (let i = 0; i < BLADE_COUNT; i++) {
      dummy.position.set(
        THREE.MathUtils.randFloatSpread(platform_width / 2),
        1.5,
        THREE.MathUtils.randFloatSpread(platform_depth / 2),
      );
      dummy.updateMatrix();
      matrices.push(dummy.matrix.clone());
    }
    return matrices;
  }, [BLADE_COUNT, platform_width, platform_depth]);

  
  useEffect(() => {
    if (meshRefHigh.current == null || meshRefLow.current == null) return;
    const bladePosition = new THREE.Vector3();
    const radius = 40;
    let hBladeCount=0;
    let lBladeCount=0;
    for (let i = 0; i < BLADE_COUNT; i++) {
      const matrix = masterGrassMatrix[i];
      bladePosition.setFromMatrixPosition(matrix);
      const distance = camera.position.distanceTo(bladePosition);
      if (distance < radius) {
        meshRefHigh.current.setMatrixAt(hBladeCount, matrix);
        hBladeCount+=1;
      } else {
        meshRefLow.current.setMatrixAt(lBladeCount, matrix);
        lBladeCount+=1; 
      }
      console.log(lBladeCount)
      meshRefHigh.current.instanceMatrix.needsUpdate = true;
      meshRefLow.current.instanceMatrix.needsUpdate = true;
      setHighResBladeCount(hBladeCount)
      setLowResBladeCount(lBladeCount)
    }
  }, [masterGrassMatrix,BLADE_COUNT]);
  
  useFrame((state) => {
    activeMaterial.uniforms.uTime.value = state.clock.elapsedTime;
  });

  console.log(highResBladeCount," ",meshRefHigh)
  return (
    <>
      <instancedMesh
        key={BLADE_COUNT + bladeMaterial + "HIGH"}
        ref={meshRefHigh}
        args={[grassGeometryHigh, activeMaterial, highResBladeCount]}
      />
      <instancedMesh
        key={BLADE_COUNT + bladeMaterial + "LOW"}
        ref={meshRefLow}
        args={[grassGeometryLow, activeMaterial, lowResBladeCount]}
      />
    </>
  );
};

export default Grass;
